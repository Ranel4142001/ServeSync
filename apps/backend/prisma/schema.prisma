generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    CLIENT
    AGENT
    ADMIN
}

enum TicketStatus {
    OPEN
    IN_PROGESS
    RESOLVED
    CLOSED
}

enum TicketPriority {
    LOW
    MEDIUM
    HIGH
    URGENT
}

model Organization {
    id        Int      @id @default(autoincrement()) // Changed to Int
    code      String?  @unique
    name      String
    slug      String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    users     User[]
    tickets   Ticket[]
    invoices  Invoice[]

    @@map("organizations")
}

model User {
    id           Int      @id @default(autoincrement()) // Changed to Int
    email        String   @unique
    passwordHash String
    firstName    String
    lastName     String
    role         Role     @default(CLIENT)
    isActive     Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    organizationId Int    // Changed to Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    assignedTickets Ticket[]  @relation("AgentTickets")
    clientTickets   Ticket[]  @relation("ClientTickets")
    messages        Message[]

    @@index([organizationId])
    @@map("users")
}

model Ticket {
    id        Int            @id @default(autoincrement()) // Changed to Int
    title     String
    status    TicketStatus   @default(OPEN)
    priority  TicketPriority @default(MEDIUM)
    category  String?        @default("Uncategorized")
    aiTriage  String?
    createdAt DateTime       @default(now())
    updatedAt DateTime       @updatedAt

    organizationId Int    // Changed to Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    clientId Int?        // Changed to Int?
    client   User?  @relation("ClientTickets", fields: [clientId], references: [id], onDelete: SetNull)

    agentId Int?         // Changed to Int?
    agent   User?   @relation("AgentTickets", fields: [agentId], references: [id], onDelete: SetNull)

    messages  Message[]
    documents Document[]

    @@index([organizationId])
    @@index([clientId])
    @@index([agentId])
    @@index([createdAt])
    @@map("tickets")
}

model Message {
    id        Int      @id @default(autoincrement()) // Changed to Int
    body      String
    isAiDraft Boolean  @default(false)
    createdAt DateTime @default(now())

    ticketId Int       // Changed to Int
    ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

    authorId Int?      // Changed to Int?
    author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

    @@index([ticketId, createdAt])
    @@index([authorId])
    @@map("messages")
}

model Document {
    id        Int      @id @default(autoincrement()) // Changed to Int
    fileName  String
    s3Key     String
    mimeType  String
    sizeBytes Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    ticketId Int       // Changed to Int
    ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

    @@index([ticketId, createdAt])
    @@map("documents")
}

model Invoice {
    id          Int       @id @default(autoincrement()) // Changed to Int
    number      String?   @unique
    amount      Float
    currency    String    @default("USD")
    description String?
    paidAt      DateTime?
    createdAt   DateTime  @default(now())

    organizationId Int    // Changed to Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
    @@index([createdAt])
    @@map("invoices")
}